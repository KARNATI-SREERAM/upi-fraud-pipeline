# Copy to .env to override defaults (docker compose reads .env automatically). No secrets here.
# Inside compose the producer reaches Kafka at kafka:9092; from your Mac use localhost:9094.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TXNS_PER_SEC=20
# FRAUD_RATE = share of transactions that are fraud; DIRTY_RATE = share of events that are dirty.
FRAUD_RATE=0.02
DIRTY_RATE=0.05
NUM_USERS=2000
# SEED fixes the user population; the transaction stream is random on every run.
SEED=42

# PostgreSQL (local dev values only; use a real secret manager in production).
# From your Mac: postgresql://pipeline:pipeline@localhost:5433/upi
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=upi
